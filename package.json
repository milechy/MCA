{
  "name": "mca",
  "version": "1.0.0",
  "description": "24-hour autonomous development system foundation",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test:e2e": "playwright test tests/e2e",
    "test:ralph": "playwright test --config=playwright.ralph.config.js",
    "test:telegram": "playwright test --config=playwright.telegram.config.js",
    "telegram:check-env": "node scripts/telegram/check-env.js",
    "telegram:inspect-logs": "node scripts/telegram/inspect-logs.js",
    "telegram:preflight-no-secrets": "node scripts/telegram/preflight-no-secrets.js",
    "telegram:default-off-smoke": "node scripts/telegram/default-off-smoke.js",
    "telegram:dry-transport-smoke": "node scripts/telegram/dry-transport-smoke.js",
    "telegram:create-run-all-smoke-approval": "node scripts/telegram/create-run-all-smoke-approval.js",
    "telegram:real-run-all-smoke": "bash scripts/telegram/real-run-all-smoke.sh",
    "telegram:real-opencode-smoke": "node scripts/telegram/real-opencode-operational-smoke.js",
    "ralph:real-external-agent-smoke": "node scripts/ralph/real-external-agent-smoke.js",
    "ralph:autonomous-daemon": "node scripts/ralph/autonomous-daemon.js",
    "telegram:real-transport-guard": "node scripts/telegram/real-transport-guard.js",
    "telegram:real-readonly-smoke": "node scripts/telegram/real-readonly-smoke.js",
    "telegram:poll-update-smoke": "node scripts/telegram/poll-update-smoke.js",
    "telegram:validate-smoke-report": "node scripts/telegram/validate-smoke-report.js",
    "telegram:ci-smoke": "npm run telegram:preflight-no-secrets && npm run telegram:check-env --if-present && npm run telegram:dry-transport-smoke && npm run telegram:inspect-logs --if-present",
    "test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milechy/MCA.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/milechy/MCA/issues"
  },
  "homepage": "https://github.com/milechy/MCA#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0"
  }
}
